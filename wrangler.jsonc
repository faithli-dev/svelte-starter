{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svelte-starter",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2"
    }
  ]
}
