{
  "name": "svelte-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "ui:init": "shadcn-svelte init",
    "ui:add": "shadcn-svelte add",
    "ui:skill:install": "npx -y skills add huntabyte/shadcn-svelte",
    "svelte:sections": "npx -y @sveltejs/mcp list-sections",
    "svelte:docs": "npx -y @sveltejs/mcp get-documentation",
    "svelte:fix": "npx -y @sveltejs/mcp svelte-autofixer",
    "design:install": "impeccable install -y --providers=antigravity --scope=project",
    "design:update": "impeccable update",
    "design:check": "impeccable check",
    "design:detect": "impeccable detect src/"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "sitemap": "^9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "cn": "^0.3.1",
    "drizzle-kit": "^0.31.10",
    "impeccable": "^4.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  }
}
